// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum UserType {
    ADMIN
    TRADER
}

enum TradeAction {
    BUY
    SELL
    SHORT
    LONG
    COVER
}

enum TradeMarket {
    FUTURES
    SPOT
}

enum TradeStatus {
    PARSED
    INVALID
    DISPATCHED
}

enum ExecutionStatus {
    PENDING
    SKIPPED
    PLACED
    FAILED
}

model Email {
    id String @id @default(uuid())

    from      String
    subject   String
    textBody  String?
    htmlBody  String?
    messageId String  @unique

    tradeSignal TradeSignal? // if 1 email -> 1 trade signal

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TradeSignal {
    id String @id @default(uuid())

    status TradeStatus @default(PARSED)

    symbol String
    base   String
    quote  String
    action TradeAction
    market TradeMarket

    average  Decimal?
    entry    Decimal?
    stopLoss Decimal?
    target   Decimal?

    entryPortfolioPct   Int?
    averagePortfolioPct Int?

    email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)
    emailId String @unique

    tradeSignalExchangeExtension TradeSignalExchangeExtension?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TradeSignalExchangeExtension {
    id String @id @default(uuid())

    order String
    close String?
    txid  String

    tradeSignal   TradeSignal @relation(fields: [tradeSignalId], references: [id])
    tradeSignalId String      @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model User {
    id String @id @default(uuid())

    firstName    String
    lastName     String
    email        String   @unique
    hash         String
    type         UserType
    ownershipPct Int // 1234 === 12.34%
    arn          String   @unique

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
